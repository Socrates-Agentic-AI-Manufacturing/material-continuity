AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

BEDROCK_MODEL_ID=
BEDROCK_KB_ID=

S3_DOCUMENT_BUCKET=
S3_CASE_BUCKET=

AGENTCORE_RUNTIME_ID=
AGENTCORE_GATEWAY_ID=

APP_ENV=development
LOG_LEVEL=INFO

FRONTEND_API_URL=http://localhost:8000
BACKEND_PORT=8000

# Optional OpenAI review adapter. Copy desired fields to ignored .env.local.
# Leave provider=fixtures to avoid any API calls. No default model is assumed.
MATERIAL_CONTINUITY_LLM_PROVIDER=fixtures
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=2048

# SAP AI Core (use only when MATERIAL_CONTINUITY_LLM_PROVIDER=sap_ai_core)
SAP_AI_CORE_CLIENT_ID=
SAP_AI_CORE_CLIENT_SECRET=
SAP_AI_CORE_TOKEN_URL=
SAP_AI_CORE_API_URL=
SAP_AI_CORE_DEPLOYMENT_ID=d1a82575de60e02a
SAP_AI_CORE_RESOURCE_GROUP=default
SAP_AI_CORE_TIMEOUT_SECONDS=20
SAP_AI_CORE_MAX_OUTPUT_TOKENS=2048
